# Email Notification Configuration for Thakii Backend
# Copy this to your .env file and configure with your Brevo API settings

# Brevo API Configuration (Required)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=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

# Email Sender Information
