# Worker Configuration for Primary/Fallback System
# Copy these settings to your .env file and configure accordingly

# Primary Worker (thakii-3) - Main processing server
PRIMARY_WORKER_URL=https://thakii-03.fanusdigital.site/thakii-worker

# Fallback Worker (thakii-02) - Backup processing server
FALLBACK_WORKER_URL=https://thakii-02.fanusdigital.site/thakii-worker

# Legacy Worker URL (for backwards compatibility)
# If PRIMARY_WORKER_URL is not set, this will be used as primary
WORKER_SERVICE_URL=https://thakii-02.fanusdigital.site/thakii-worker

# Worker Priority Mode
# Options: primary-only, primary-with-fallback (default), round-robin
WORKER_PRIORITY_MODE=primary-with-fallback

# Worker Health Check Timeout (seconds)
WORKER_HEALTH_TIMEOUT=5

# Worker Request Timeout (seconds)
WORKER_REQUEST_TIMEOUT=30

